# 平台本地运行端口号
VITE_PORT = 8848

# mock 开关（唯一 mock 开关：true = fake-server 拦截请求；false = 走真接口）
# 与 VITE_PROXY_TARGET 同时启用时按路由粒度叠加：命中 mock 路由的请求被 fake-server 拦截
# （其中间件注册在 Vite 内部 proxy 之前），未命中 mock 的路径穿透代理到真实后端。
# 因此建议全开（调试 mock）或全关（联调后端），避免"登录是假的、部分数据是真的"混合态。
VITE_USE_MOCK = false

# 后端服务地址（dev 本地跨域代理的转发目标；留空 = 不启用代理，如后端单 jar 同源托管前端时）
VITE_PROXY_TARGET = http://localhost:9666

# 开发环境读取配置文件路径
VITE_PUBLIC_PATH = /

# 开发环境路由历史模式（Hash模式传"hash"、HTML5模式传"h5"、Hash模式带base参数传"hash,base参数"、HTML5模式带base参数传"h5,base参数"）
VITE_ROUTER_HISTORY = "hash"
